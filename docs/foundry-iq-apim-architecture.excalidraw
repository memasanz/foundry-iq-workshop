      "width": 300,
      "height": 135.0,
      "text": "3. OBO exchange\nBroker authenticates\nwith its APIM-held secret",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
