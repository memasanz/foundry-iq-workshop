        ],
        [
          0,
          220
        ]
      ],
      "strokeColor": "#107C10",
      "strokeWidth": 3,
      "endArrowhead": "arrow"
    },
    {
      "type": "text",
      "id": "targets-label",
      "x": 1395,
      "y": 610,
      "width": 350,
      "height": 135.0,
      "text": "No new ingestion in lab 12\nNo live SharePoint site call\nfor the indexed source",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "return-note",
      "x": 40,
      "y": 1085,
      "width": 1730,
      "height": 105.0,
      "text": "Answer + references return through APIM to the notebook. The stored Web IQ key is not a user's document credential.\nRetrieval needs a broker token; direct source/KB setup still needs the user's Search RBAC. Shared services are not per-user isolation.",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "identities-heading",
      "x": 40,
      "y": 1190,
      "width": 1730,
      "height": 67.5,
      "text": "Which identity / app registration does what?",
      "fontSize": 27,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "broker-role",
      "x": 40,
      "y": 1255,
      "width": 550,
      "height": 300,
      "strokeColor": "#5C2D91",
      "backgroundColor": "#E8DAEF",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "broker-role-text",
      "x": 60,
      "y": 1275,
      "width": 510,
      "height": 270.0,
      "text": "Broker app registration (lab 12)\nExpose user_impersonation to Azure CLI\nRequest delegated Search permission\nAdmin consent enables downstream OBO\nAPIM stores broker-client-secret\nNOT the SharePoint ingestion app",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "apim-role",
      "x": 625,
      "y": 1255,
      "width": 550,
      "height": 300,
      "strokeColor": "#0078D4",
      "backgroundColor": "#CFE4FA",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "apim-role-text",
      "x": 645,
      "y": 1275,
      "width": 510,
      "height": 270.0,
      "text": "APIM system-assigned identity\nGets T3 without a broker client secret\nNeeds Search Index Data Reader\nat the Search service scope\nThis does not replace T2 user context\nor grant the user SharePoint access",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "ingestion-role",
      "x": 1210,
      "y": 1255,
      "width": 550,
      "height": 300,
      "strokeColor": "#495057",
      "backgroundColor": "#F3F2F1",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "ingestion-role-text",
      "x": 1230,
      "y": 1275,
      "width": 510,
      "height": 270.0,
      "text": "SharePoint ingestion app (lab 07)\nTrusts Search managed identity (federation)\nApproved app permissions + site grant\nPopulate the indexed content / ACLs\nNo ingestion-app secret for this path\nNOT used for APIM's runtime OBO",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    }
