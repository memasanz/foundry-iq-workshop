      "x": 220,
      "y": 780,
      "width": 350,
      "height": 135.0,
      "text": "1. Sign in; acquire T1\napi://<broker-id>/.default\nExposed user_impersonation scope",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
