      }
    },
    {
      "type": "text",
      "id": "targets-text",
      "x": 1400,
      "y": 795,
      "width": 340,
      "height": 270.0,
      "text": "5. Retrieve + synthesize\n\nExisting CU Blob index (05)\nExisting SharePoint ACL index (07)\nWeb IQ MCP: public web\nFoundry models via Search identity",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "arrow",
      "id": "search-targets",
      "x": 1730,
