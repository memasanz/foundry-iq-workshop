      "x": 1350,
      "y": 785,
      "width": 390,
      "height": 285.0,
      "text": "Azure AI Search knowledge base\n\n<prefix>-toolbox-kb /mcp\nAgent token: Search audience\nAgent needs Search data-read role\nOnly source: <prefix>-kb-blob",
      "fontSize": 19,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
