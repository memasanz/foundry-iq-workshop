        "type": 3
      }
    },
    {
      "type": "text",
      "id": "user-role-text",
      "x": 60,
      "y": 1330,
      "width": 510,
      "height": 225.0,
      "text": "Your user: prepares the resources\nCreate KB, project connection and toolbox\nWrite/zip Python files; remote-build agent\nFoundry authoring + Search authoring/read\nRole-assignment rights only for grant step",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "agent-role",
      "x": 625,
      "y": 1310,
      "width": 550,
      "height": 270,
      "strokeColor": "#5C2D91",
      "backgroundColor": "#E8DAEF",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "agent-role-text",
      "x": 645,
      "y": 1330,
      "width": 510,
      "height": 225.0,
      "text": "Agent principal: runtime Search caller\nExists after hosted deployment\nGrant Search Index Data Reader on Search\nUse version.instance_identity.principal_id\nUser/project Search grants do not replace it",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "connection-role",
      "x": 1210,
      "y": 1310,
      "width": 550,
      "height": 270,
      "strokeColor": "#495057",
      "backgroundColor": "#F3F2F1",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "connection-role-text",
      "x": 1230,
      "y": 1330,
      "width": 510,
      "height": 225.0,
      "text": "Connection + toolbox: configure the tool\nConnection stores target + auth settings\nNo new broker app or client secret here\nPromote new toolbox default without\nredeploying the agent; verify compatibility",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
