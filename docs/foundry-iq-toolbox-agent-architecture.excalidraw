  "elements": [
    {
      "type": "text",
      "id": "title",
      "x": 40,
      "y": 20,
      "width": 1720,
      "height": 75.0,
      "text": "Lab 14: a hosted agent retrieves Blob knowledge through a Foundry toolbox",
      "fontSize": 30,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "subtitle",
      "x": 40,
      "y": 85,
      "width": 1720,
      "height": 105.0,
      "text": "The user invokes the agent. The toolbox calls Search using the agent's own identity, not the user's or project's.\nThis lab is Blob-only: no APIM broker, Web IQ key or per-user SharePoint on-behalf-of exchange.",
      "fontSize": 21,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "caller",
      "x": 40,
      "y": 215,
      "width": 310,
      "height": 340,
      "strokeColor": "#0078D4",
      "backgroundColor": "#CFE4FA",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "caller-text",
      "x": 60,
      "y": 235,
      "width": 270,
      "height": 285.0,
      "text": "Notebook user\n\nAzure CLI sign-in\nResponses API invocation\nReceives agent answer\nand tool-call output",
      "fontSize": 19,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "agent",
      "x": 580,
      "y": 215,
      "width": 440,
      "height": 340,
      "strokeColor": "#5C2D91",
      "backgroundColor": "#E8DAEF",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "agent-text",
      "x": 600,
      "y": 235,
      "width": 400,
      "height": 332.5,
      "text": "Hosted agent in Foundry\n\n<prefix>-iq-agent\nmain.py / ResponsesHostServer\nAgent + FoundryChatClient\nFoundryToolbox(credential)\nTOOLBOX_NAME selects the toolbox",
      "fontSize": 19,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "toolbox",
      "x": 1330,
      "y": 215,
      "width": 430,
      "height": 340,
      "strokeColor": "#5C2D91",
      "backgroundColor": "#E8DAEF",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "toolbox-text",
      "x": 1350,
      "y": 235,
      "width": 390,
      "height": 332.5,
      "text": "Foundry toolbox\n\n<prefix>-iq-toolbox\nStable endpoint, default version\nMCP tool: knowledge_base_retrieve\nrequire_approval = never\nConnection controls authentication",
      "fontSize": 19,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
