      "y": 785,
      "width": 270,
      "height": 270.0,
      "text": "Existing indexed Blob content\n\nLab 05: <prefix>-cu-chunks\nLab 11: <prefix>-kb-blob\nText + PDF source metadata\nNo new upload or indexing",
      "fontSize": 18,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
