      "height": 67.5,
      "text": "Setup permissions and runtime identities are not interchangeable",
      "fontSize": 27,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "user-role",
      "x": 40,
      "y": 1310,
      "width": 550,
      "height": 270,
      "strokeColor": "#0078D4",
      "backgroundColor": "#CFE4FA",
      "fillStyle": "solid",
      "strokeWidth": 2,
