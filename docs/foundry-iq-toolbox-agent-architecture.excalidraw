    },
    {
      "type": "text",
      "id": "models-text",
      "x": 600,
      "y": 785,
      "width": 400,
      "height": 285.0,
      "text": "Foundry models: two layers\n\nAgent model: decides tool use\nand produces final response\nKB models: planning + synthesis\nSearch uses its own model identity",
      "fontSize": 19,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "textAlign": "left",
      "verticalAlign": "top"
    },
