# Copy to .env after linking the deployed resource at https://webiq.microsoft.ai/profiles.
# Deployment writes non-secret settings to .env.azure; do not copy those settings here.
WEBIQ_API_KEY=

# Account entitlements vary. Set true only after confirming access in the Web IQ portal.
WEBIQ_ENABLE_NEWS=false
WEBIQ_ENABLE_IMAGES=false
WEBIQ_ENABLE_VIDEOS=false
WEBIQ_ENABLE_BROWSE=false
WEBIQ_ENABLE_PLACES=false
WEBIQ_ENABLE_AUTO=false

# Unique attendee prefix for the Search labs: 3-20 lowercase letters/digits, starting with a letter.
WORKSHOP_PREFIX=

# Notebook 06 also uses WEBIQ_API_KEY and SHAREPOINT_SITE_URL. Optional overrides:
# WEBIQ_KB_TOOLS=web
# AZURE_AI_MODEL_NAME=gpt-5-mini
# AZURE_AI_EMBEDDING_MODEL_NAME=text-embedding-3-small

# Notebook 04: a dedicated, non-sensitive SharePoint test site (notebooks 04, 05 and 06).
SHAREPOINT_SITE_URL=

# Notebook 04 only: run scripts\setup-sharepoint-app.ps1 or complete notebook 04's facilitator app-registration walkthrough.
# These are non-secret identifiers, not client secrets.
SHAREPOINT_APP_CLIENT_ID=
SHAREPOINT_APP_OBJECT_ID=
# Application/client ID of SEARCH'S managed identity, not its principal ID or the FIC object ID.
SHAREPOINT_SEARCH_MI_CLIENT_ID=

# Notebook 07 (APIM gateway): values printed by scripts\setup-broker-app.ps1 and scripts\setup-apim-policy.ps1.
BROKER_APP_CLIENT_ID=
APIM_GATEWAY_URL=
WEBIQ_APIM_SOURCE_NAME=iq-workshop-webiq
