# Copy to .env after linking the deployed resource at https://webiq.microsoft.ai/profiles.
# Deployment writes non-secret settings to .env.azure; do not copy those settings here.
WEBIQ_API_KEY=

# Your attendee alias throughout the workshop: 3-20 lowercase letters/digits, starting with a letter.
# Prefixes attendee-created resources and generated-agent folders; shared infrastructure stays shared.
# Keep the same value between notebooks. Naming prevents collisions, not unauthorized access.
WORKSHOP_PREFIX=

# Notebook 09 reuses the existing Blob and SharePoint indexes and WEBIQ_API_KEY.
# It stores this workshop key in its Web IQ knowledge source for portal retrieval.
# Authorized callers share the key's quota/billing; rotate/revoke it after use.
# Select notebook 04's or 05's Blob index in its configuration cell. Optional overrides:
# Notebook 09 uses only the basic Web IQ web search tool, not Auto.
# AZURE_AI_MODEL_NAME=gpt-5-mini

# Notebooks 04-07 share the deployed embedding model; 09 reuses the indexes' vectorizers.
# Optional model-name override for indexing:
# AZURE_AI_EMBEDDING_MODEL_NAME=text-embedding-3-small
# 04-07 use 1536 dimensions; keep the skill/client embeddings and vector field consistent.

# A dedicated, non-sensitive SharePoint test site (notebooks 07 and 08).
SHAREPOINT_SITE_URL=

# Notebook 07 only: run scripts\setup-sharepoint-app.ps1 or complete notebook 07's app-registration walkthrough.
# These are non-secret identifiers, not client secrets.
SHAREPOINT_APP_CLIENT_ID=
SHAREPOINT_APP_OBJECT_ID=
# Application/client ID of SEARCH'S managed identity, not its principal ID or the FIC object ID.
SHAREPOINT_SEARCH_MI_CLIENT_ID=

# Notebook 10: existing APIM service; Bicep does not create one.
# Both facilitator setup scripts read this resource ID from .env.
APIM_RESOURCE_ID=
# Values printed by scripts\setup-broker-app.ps1 and scripts\setup-apim-policy.ps1.
BROKER_APP_CLIENT_ID=
APIM_GATEWAY_URL=
# Shared facilitator-created source; notebook 10 reads it without modifying it.
WEBIQ_APIM_SOURCE_NAME=iq-workshop-webiq

# Notebook 12 creates its own {WORKSHOP_PREFIX}-iq-search-mcp connection using .env.azure.
# No pre-created connection or TOOLBOX_CONNECTION_NAME setting is required.

# Advanced notebook 13: bind this caller client ID in the Web IQ profile portal.
# Local exercise prompts for a short-lived Entra app secret; do not put it here.
# WEBIQ_AUTH_MODE=client_secret
# WEBIQ_CLIENT_ID=
# WEBIQ_TENANT_ID=  # Optional when .env.azure already supplies AZURE_TENANT_ID.
# WEBIQ_APP_ID=     # Web IQ profile AppID; required if the caller has multiple bindings.
# On Azure compute only, WEBIQ_AUTH_MODE can be system_assigned or user_assigned.
