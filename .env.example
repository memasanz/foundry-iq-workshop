# Copy to .env after linking the deployed resource at https://webiq.microsoft.ai/profiles.
# Deployment writes non-secret settings to .env.azure; do not copy those settings here.
WEBIQ_API_KEY=

# Notebooks 02-03: only needed if the shared Web IQ connection has a different name.
# WEBIQ_CONNECTION_NAME=webiq-mcp

# Notebook 01 runs all six core APIs by default. Set false only to skip an exercise.
# Auto still requires service-side AppID enablement; these flags do not grant access.
WEBIQ_ENABLE_NEWS=true
WEBIQ_ENABLE_IMAGES=true
WEBIQ_ENABLE_VIDEOS=true
WEBIQ_ENABLE_BROWSE=true
WEBIQ_ENABLE_PLACES=false
WEBIQ_ENABLE_AUTO=true

# Unique attendee prefix for the Search labs: 3-20 lowercase letters/digits, starting with a letter.
WORKSHOP_PREFIX=

# Notebook 08 also uses WEBIQ_API_KEY and SHAREPOINT_SITE_URL. Optional overrides:
# WEBIQ_KB_TOOLS=web
# AZURE_AI_MODEL_NAME=gpt-5-mini

# Notebooks 04, 05 and 08 share the deployed embedding model. Optional model-name override:
# AZURE_AI_EMBEDDING_MODEL_NAME=text-embedding-3-small
# 04-05 use 1536 dimensions; keep the skill/client embeddings and vector field consistent.

# Notebook 06: a dedicated, non-sensitive SharePoint test site (notebooks 06, 07 and 08).
SHAREPOINT_SITE_URL=

# Notebook 06 only: run scripts\setup-sharepoint-app.ps1 or complete notebook 06's facilitator app-registration walkthrough.
# These are non-secret identifiers, not client secrets.
SHAREPOINT_APP_CLIENT_ID=
SHAREPOINT_APP_OBJECT_ID=
# Application/client ID of SEARCH'S managed identity, not its principal ID or the FIC object ID.
SHAREPOINT_SEARCH_MI_CLIENT_ID=

# Notebook 09: existing APIM service; Bicep does not create one.
# Both facilitator setup scripts read this resource ID from .env.
APIM_RESOURCE_ID=
# Values printed by scripts\setup-broker-app.ps1 and scripts\setup-apim-policy.ps1.
BROKER_APP_CLIENT_ID=
APIM_GATEWAY_URL=
WEBIQ_APIM_SOURCE_NAME=iq-workshop-webiq

# Notebook 11 (toolbox agent): only needed if the facilitator changed the connection name from the default.
# TOOLBOX_CONNECTION_NAME=iq-workshop-search-mcp

# Advanced notebook 12: bind this caller client ID in the Web IQ profile portal.
# Local exercise prompts for a short-lived Entra app secret; do not put it here.
# WEBIQ_AUTH_MODE=client_secret
# WEBIQ_CLIENT_ID=
# WEBIQ_TENANT_ID=  # Optional when .env.azure already supplies AZURE_TENANT_ID.
# WEBIQ_APP_ID=     # Web IQ profile AppID; required if the caller has multiple bindings.
# On Azure compute only, WEBIQ_AUTH_MODE can be system_assigned or user_assigned.
